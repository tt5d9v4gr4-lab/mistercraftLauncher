{
  "name": "mistercraft-launcher",
  "productName": "MisterCraft Launcher",
  "version": "1.0.0",
  "description": "MisterCraft Launcher — лаунчер Minecraft Java Edition",
  "main": "main.js",
  "author": "MisterCraft",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icon.js",
    "test": "node tests/run.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mistercraft.launcher",
    "productName": "MisterCraft Launcher",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MisterCraft Launcher",
      "artifactName": "MisterCraft-Setup.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
